---
import Layout from '../layouts/Layout.astro'
import BackgroundSection from '../components/BackgroundSection.astro'
import IconLink from '../components/IconLink.astro'
---

<Layout 
  title="About | Brianna Marie Rickey"
  description="Learn more about Brianna Rickey, an aspiring cybersecurity specialist with a passion for social engineering, threat analysis, and digital defense. Connect with her on GitHub and LinkedIn."
>
  <BackgroundSection opacity={1}>
    <div class="mb-4 flex items-center">
      <a
        href="/"
        class="px-3 py-1 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 transition text-sm"
        aria-label="Back to Home"
      >
        ← Back to Home
      </a>
    </div>

    <main class="bg-mobilebg sm:bg-desktopbg text-gray-900">
      <section class="text-center bg-black bg-opacity-20 rounded-lg p-8">
        <h1 class="text-4xl font-bold mb-6 text-white">About Me</h1>
        <div class="text-lg leading-relaxed space-y-4 text-gray-100">
          <p>
            I’m Brianna, an aspiring cybersecurity specialist passionate about protecting digital
            worlds with creativity, compassion, and determination.
          </p>
          <p>
            My journey began with a curiosity for technology and a drive to understand how systems
            work — especially how they can be protected against threats.
          </p>
          <p>
            I'm currently building expertise in incident response, Python scripting, and vulnerability
            assessment to help organizations identify risks and respond effectively to threats.
          </p>
          <p>
            When I’m not diving into cybersecurity, I enjoy gardening, rock hounding, and spending
            time with my dogs.
          </p>
        </div>
      </section>

      <section class="text-center bg-black bg-opacity-20 rounded-lg p-8 mt-8">
        <h2 class="text-2xl font-bold mb-6 text-white">Connect With Me</h2>
        <div class="flex justify-center space-x-6">
          <IconLink
            href="https://github.com/brickey-cypher"
            svgPath="/svgs/github.svg"
            label="GitHub"
          />
          <IconLink
            href="https://www.linkedin.com/in/brianna-rickey-ab1ab5357/"
            svgPath="/svgs/linkedin.svg"
            label="LinkedIn"
          />
          <IconLink
            href="mailto:brimarie7797@gmail.com"
            svgPath="/svgs/email.svg"
            label="Email"
          />
        </div>
      </section>
    </main>
  </BackgroundSection>
</Layout>
