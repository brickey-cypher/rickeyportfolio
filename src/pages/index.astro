---
import Layout from '../layouts/Layout.astro'
import BackgroundSection from '../components/BackgroundSection.astro'
import { Image } from 'astro:assets'
import lighthouseScore from '../assets/lighthouse-score.jpg'
---

<Layout 
  title="Brianna Marie Rickey | Cybersecurity Portfolio"
  description="Brianna's cybersecurity portfolio – showcasing skills in digital defense, threat analysis, and social engineering. Explore projects and learn more about her passion for cybersecurity."
>

  <main class="bg-mobilebg sm:bg-desktopbg" id="main-content" role="main">
  <BackgroundSection backgroundImage="/backgrounds/bg-optimized.webp" opacity={0.9} fadeIntensity="medium">
      <div class="text-center text-s text-black bg-gray-300 bg-opacity-70 p-1 rounded mb-1 border border-purple-500 sm:mx-auto max-w-xl">
    For the best experience, switch to desktop view in your mobile browser.
  </div>
          <Image 
    src={lighthouseScore} 
    alt="Lighthouse performance score of my portfolio site"
    widths={[200, 400, 800]}
    sizes="(max-width: 360px) 200px, (max-width: 768px) 400px, 800px"
    format="webp"
    class="w-automax-w-4xl rounded-xl shadow-x3 mx-auto mt-1 mb-1"
    />
    <section class="max-w-3xl mx-auto py-12 px-6 text-center bg-black bg-opacity-20 rounded-lg">
      <h1 class="text-4xl font-bold mb-4 text-white">
        Welcome to My Cybersecurity Portfolio
      </h1>
      <p class="text-lg text-gray-100">
        Hi, I'm Brianna—an aspiring cybersecurity specialist focused on social engineering,
        threat analysis, and digital defense.
      </p>

      <div class="mt-10 flex flex-col items-center space-y-4">
        <a
          href="/about"
          class="w-40 bg-blue-600 text-white px-1 py-2 rounded hover:bg-green-700 transition text-center"
        >
          About Me
        </a>

        <a
          href="/projects"
          class="w-52 bg-purple-600 text-white px-2 py-2 rounded hover:bg-green-700 transition text-center"
        >
          Projects
        </a>

        <a
          href="/behind-the-scenes"
          class="w-64 bg-blue-900 text-gray-300 px-3 py-2 rounded hover:bg-white hover:shadow transition text-center"
        >
          Go Behind the Scenes
        </a>

        <div class="flex items-start gap-2 text-s text-gray-200 -mt-2">
          <p>Want to know what went into making this site?</p>
          <span class="text-lg leading-none pt--3">⇖</span>
        </div>
      </div>
    </section>
  </BackgroundSection>
  </main>
</Layout>

