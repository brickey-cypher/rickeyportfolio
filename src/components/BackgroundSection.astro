---
import ThemeToggle from "./ThemeToggle";

const {
  backgroundImage = '/backgrounds/bg-optimized.webp',
  opacity = 0.2,
  textOutline = true,
  fadeIntensity = 'light'
} = Astro.props;

const fadePresets = {
  subtle: { blur: 3, height: 8, opacity: 0.1 },
  medium: { blur: 5, height: 12, opacity: 0.8 },
  strong: { blur: 8, height: 16, opacity: 0.9 }
};
const fade = fadePresets[fadeIntensity] || fadePresets.medium;
---

<!-- Background wrapper with lazy-loaded image -->
<div class="fixed inset-0 -z-10" id="bg-wrapper" data-bg={backgroundImage} aria-hidden="true">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`opacity: ${opacity};`}
  ></div>

  <!-- Matrix rain canvas -->
  <canvas
    id="matrix-overlay"
    class="absolute inset-9 w-full h-full opacity-100"
  ></canvas>
</div>

<!-- Foreground content -->
<div class="relative z-10 min-h-screen text-white">

  <!-- Optional overlays for depth and color gradient -->
  <div
    class="absolute inset-0 bg-violet-950"
    style={`opacity: ${opacity * 0.1};`}
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent to-violet-950"
    style={`opacity: ${opacity * 0.2};`}
    aria-hidden="true"
  ></div>

  <!-- Top and bottom fade transitions -->
  <div
    class="layer-connector layer-connector-top"
    style={`--fade-height: ${fade.height}px; --fade-blur: ${fade.blur}px; --fade-opacity: ${fade.opacity};`}
    aria-hidden="true"
  ></div>

  <div
    class="layer-connector layer-connector-bottom"
    style={`--fade-height: ${fade.height}px; --fade-blur: ${fade.blur}px; --fade-opacity: ${fade.opacity};`}
    aria-hidden="true"
  ></div>

  <!-- Slot for page content -->
  <div class={`relative z-20 max-w-4xl mx-auto py-16 px-4 ${textOutline ? 'text-outline' : ''}`}>
    <div class="toggle-button-wrapper pt-[calc(var(--fade-height)/2)] hidden">
      <slot name="toggle">
        <ThemeToggle client:load />
      </slot>
    </div>
    <slot />
  </div>
</div>

<style is:global>
  html, body {
    height: 100%;
    margin: 0;
    background: transparent;
  }

  .text-outline {
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bgWrapper = document.getElementById('bg-wrapper');
    const bgUrl = bgWrapper?.dataset.bg;

    if (!bgWrapper || !bgUrl) return;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const bgDiv = bgWrapper.querySelector('div.bg-cover');
          if (bgDiv) {
            bgDiv.style.backgroundImage = `url('${bgUrl}')`;
          }
          obs.unobserve(bgWrapper);
        }
      });
    });

    observer.observe(bgWrapper);

    // You can add your Matrix rain drawing logic here if needed
  });
</script>



