---
import { theme } from '../stores/theme'
import '../styles/global.css'
// import ThemeToggle from '../components/ThemeToggle.jsx'
const { title = 'Brianna Marie Rickey | Cybersecurity Portfolio' } = Astro.props
---
<!doctype html>
<html lang="en" class={theme.value ? 'dark' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Rickey's professional cybersecurity portfolio – showcasing skills, projects, and passion for digital defense.">
    <meta name="generator" content={Astro.generator} />
    <style is:inline>
      html, body {
        background-color: transparent !important;
      }
    </style>
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored === 'dark' || (!stored && prefersDark);
        if (isDark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="text-white dark:text-white transition-colors duration-300">
    <slot />
    <!-- ThemeToggle removed for now -->
  </body>
</html>



